<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clickable="true"
    android:orientation="vertical"
    android:paddingHorizontal="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/muClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="-12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:src="@drawable/ic_expand_more" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/now_playing"
            android:textColor="@color/sub"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/muTimer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="-12dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/sleep"
            android:src="@drawable/ic_timer" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/muCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/muTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/muArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/sub"
        android:textSize="15sp" />

    <SeekBar
        android:id="@+id/muSeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="-16dp"
        android:layout_marginTop="16dp"
        android:max="1000"
        android:progressTint="#FFFFFFFF"
        android:thumbTint="#FFFFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/muPos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/sub"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/muDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/sub"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/muShuffle"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/shuffle"
            android:src="@drawable/ic_shuffle" />

        <ImageButton
            android:id="@+id/muPrev"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/previous"
            android:scaleX="1.4"
            android:scaleY="1.4"
            android:src="@drawable/ic_skip_prev" />

        <ImageButton
            android:id="@+id/muPlay"
            android:layout_width="0dp"
            android:layout_height="72dp"
            android:layout_weight="1.3"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/play_pause"
            android:scaleX="2"
            android:scaleY="2"
            android:src="@drawable/ic_pause" />

        <ImageButton
            android:id="@+id/muNext"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/next"
            android:scaleX="1.4"
            android:scaleY="1.4"
            android:src="@drawable/ic_skip_next" />

        <ImageButton
            android:id="@+id/muRepeat"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/repeat"
            android:src="@drawable/ic_repeat" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/muQueue"
            style="@style/Chip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_queue"
            android:drawablePadding="6dp"
            android:text="@string/queue" />

        <TextView
            android:id="@+id/muLyrics"
            style="@style/Chip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:drawableStart="@drawable/ic_lyrics"
            android:drawablePadding="6dp"
            android:text="@string/lyrics" />

        <TextView
            android:id="@+id/muRadio"
            style="@style/Chip"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="0dp"
            android:layout_weight="1"
            android:text="@string/radio" />
    </LinearLayout>
</LinearLayout>
